{
  "listen_addr": ":8080",
  "issuer": "https://canner.example",
  "data_dir": "./data",
  "max_upload_bytes": 107374182400,
  "min_free_bytes": 107374182400,
  "delivery_concurrency": 2,
  "projects": {
    "example": {
      "packaging": {
        "type": "mergewarc",
        "trigger_bytes": 10737418240,
        "target_package_bytes": 1073741824,
        "max_wait": "24h"
      },
      "delivery": {
        "sink": "internet_archive",
        "credentials_file": "/run/secrets/ia.keys",
        "identifier": "saveweb-example-{{DATE}}-{{PACKAGE_ID_SHORT}}",
        "remote_name": "{{PACKAGE_FILENAME}}",
        "local_artifact_retention": "30s",
        "metadata": {
          "collection": ["replace-with-ia-collection"],
          "mediatype": ["web"],
          "title": ["Saveweb example artifact {{OBJECT_ID}}"]
        }
      }
    }
  }
}
